+++ b/node_modules/svelte-pixi/dist/svelte-5/Application.svelte
@@ -77,6 +77,16 @@ let invalidated = true;
 setApp(instance);
 onMount(() => {
     return () => {
+        // betwixt-and-between patch: upstream svelte-pixi@8.0.1 never calls
+        // app.destroy() on unmount, leaking a Pixi.Application + WebGL context
+        // every mount/unmount cycle. Browsers cap WebGL contexts at ~16. See
+        // docs/plans/world-map-v3-pre-slice-0-spike-findings.md § HMR teardown.
+        try {
+            instance?.destroy(true, { children: true, texture: true, textureSource: true, context: true });
+        }
+        catch (_) {
+            // ignore: Pixi destroy can throw if context was already lost
+        }
         instance = undefined;
     };
 });
