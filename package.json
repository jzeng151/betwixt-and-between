{
  "name": "betwixt-and-between",
  "private": true,
  "version": "0.8.12.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:pglite": "tsx scripts/dev-pglite.ts",
    "build": "vite build",
    "preview": "vite preview",
    "cf:preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "cf:typegen": "wrangler types",
    "prepare": "svelte-kit sync || echo ''",
    "postinstall": "patch-package",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run",
    "test:e2e": "playwright test",
    "seed": "tsx scripts/seed/cli.ts",
    "docs:schema": "tsx scripts/docs/generate-schema-md.ts",
    "docs:api": "tsx scripts/docs/generate-api-md.ts",
    "docs:edges": "tsx scripts/docs/generate-edges-md.ts",
    "docs:all": "npm run docs:schema && npm run docs:api && npm run docs:edges",
    "gen:palette-css": "tsx scripts/gen-palette-css.ts",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "name": "client bundle (gzipped)",
      "path": ".svelte-kit/output/client/_app/immutable/**/*.js",
      "limit": "1.2 MB",
      "gzip": true
    }
  ],
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.5",
    "@electric-sql/pglite-socket": "^0.1.5",
    "@playwright/test": "^1.60.0",
    "@size-limit/file": "^12.1.0",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/adapter-cloudflare": "^7.2.8",
    "@sveltejs/kit": "^2.57.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@types/node": "^24",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "jsdom": "^29.1.0",
    "patch-package": "^8.0.1",
    "size-limit": "^12.1.0",
    "svelte": "^5.55.2",
    "svelte-check": "^4.4.6",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.7",
    "vitest": "^4.1.3",
    "wrangler": "^4.88.0"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "better-auth": "^1.6.9",
    "lucide-svelte": "^1.0.1",
    "pixi-viewport": "^6.0.3",
    "pixi.js": "8.18.1",
    "postgres": "^3.4.9"
  }
}
